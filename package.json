    "bun": ">=1.4.3"
  },
  "description": "MKWii Advanced Editor - editor desktop di piste per Mario Kart Wii (SZS / KMP / KCL)",
  "type": "module",
  "scripts": {
    "start": "bun run scripts/build-frontend.ts && bun run src/main.ts",
